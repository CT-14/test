# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Absolute or relative path to the SQLite database file. Use :memory: for tests.
DATABASE_PATH=./data/lapsewise.db
# Public base URL, used in emails and Stripe redirect URLs.
APP_URL=http://localhost:3000
# At least 32 characters. Signs sessions and card-update links.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
LOG_LEVEL=info
# Optional until the Stripe tickets land (test mode keys only in development).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Optional: Sentry-compatible DSN for error reporting.
SENTRY_DSN=
